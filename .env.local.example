# Local Development Environment Variables
#
# Instructions:
# 1. Copy this file to .env.local
# 2. Fill in your actual values
# 3. NEVER commit .env.local to git (it's in .gitignore)

# Authentication Secret
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Local Development URL
NEXTAUTH_URL=http://localhost:3000

# Google OAuth Credentials
# Use your development OAuth credentials from Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local PostgreSQL Database
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5430/luxe_leather"

# Email Service (Optional for local testing)
RESEND_API_KEY=
GMAIL_USER=
GMAIL_APP_PASSWORD=
